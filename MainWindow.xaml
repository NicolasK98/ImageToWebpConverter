<Window
    x:Class="ImageToWebpConverter.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Convertitore Image -> WebP">

    <Grid AllowDrop="True" 
          DragOver="Grid_DragOver" 
          Drop="Grid_Drop" 
          Background="Transparent">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Padding="16,0,0,0" Background="Transparent">

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <FontIcon Glyph="&#xE8B9;" FontSize="14"/>
                <TextBlock Text="Convertitore Image in WebP" 
                   Style="{StaticResource CaptionTextBlockStyle}" 
                   VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" 
                    Padding="24,10,24,16" 
                    Spacing="12" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center" 
                    Width="400">

            <Border BorderBrush="{ThemeResource SystemControlForegroundBaseMediumLowBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="16" 
                    Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}">
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE8E5;" FontSize="28" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"/>
                    <TextBlock Text="Trascina qui le tue immagini" 
                               Style="{StaticResource BodyStrongTextBlockStyle}" 
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Supporta JPG, PNG, WEBP, AVIF, BMP, TIFF, GIF" 
                               Style="{StaticResource CaptionTextBlockStyle}" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Button x:Name="BtnSelect" 
                    Content="Seleziona Immagini" 
                    Click="BtnSelect_Click" 
                    HorizontalAlignment="Stretch"/>

            <TextBlock x:Name="TxtStatus" 
                       Text="Nessun file selezionato" 
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                       HorizontalAlignment="Center"
                       FontSize="12"/>

            <StackPanel Spacing="4" Margin="0,4,0,0">
                <TextBlock x:Name="TxtQuality" 
                           Text="Qualità WebP: 80%" 
                           Style="{StaticResource BodyTextBlockStyle}"/>
                <Slider x:Name="SliderQuality" 
                        Minimum="1" 
                        Maximum="100" 
                        Value="80" 
                        ValueChanged="SliderQuality_ValueChanged"/>
            </StackPanel>

            <Button x:Name="BtnConvert" 
                    Content="Avvia Conversione" 
                    Click="BtnConvert_Click" 
                    IsEnabled="False" 
                    Style="{StaticResource AccentButtonStyle}" 
                    HorizontalAlignment="Stretch" 
                    Margin="0,4,0,0"/>

            <ProgressBar x:Name="ProgBar" 
                         Minimum="0" 
                         Maximum="100" 
                         Value="0" 
                         HorizontalAlignment="Stretch"/>
        </StackPanel>

        <TextBlock Grid.Row="2" 
                   Text="made by Nicolas Kovac" 
                   Style="{StaticResource CaptionTextBlockStyle}" 
                   Foreground="{ThemeResource TextFillColorDisabledBrush}" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,12"/>
    </Grid>
</Window>